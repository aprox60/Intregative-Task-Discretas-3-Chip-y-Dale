/*
  ResumeLens candidate profile language (stage 4).

  A document describes one candidate: contact information, experience, education,
  normalized skills and the result of the profile classification.
  Non-terminals start with an upper case letter. Terminals are the keywords in quotes
  and the regular expressions at the end of the file.
*/

CandidateProfile:
    'candidate' name=STRING '{'
        contact=Contact
        experiences*=Experience
        educations*=Education
        skills=Skills
        evaluation=Evaluation
    '}'
;

Contact:
    'contact' '{'
        'email' ':' email=Email
        ('phone' ':' phone=Phone)?
        links*=Link
    '}'
;

Link:
    'link' ':' url=Url
;

Experience:
    'experience' '{'
        'years' ':' years=INT
        ('description' ':' description=STRING)?
    '}'
;

Education:
    'education' '{'
        'degree' ':' degree=STRING
        'field' ':' field=STRING
        ('institution' ':' institution=STRING)?
    '}'
;

Skills:
    'skills' '{' tokens*=Token[','] '}'
;

Evaluation:
    'evaluation' '{' results+=ProfileResult '}'
;

ProfileResult:
    'profile' profile=ProfileName ':' status=Status
;

ProfileName:
    'FULL_STACK_DEVELOPER' | 'MACHINE_LEARNING_ENGINEER' | 'BACKEND_DEVELOPER' | 'DATA_SCIENTIST'
;

Status:
    'ACCEPTED' | 'REJECTED'
;

// Terminals defined with regular expressions

Token:
    /[A-Z][A-Z0-9_]*/
;

Email:
    /[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+(\.[A-Za-z0-9-]+)*\.[A-Za-z]{2,}/
;

Phone:
    /\+?\(?[0-9][0-9 ()\-]{5,}[0-9]/
;

Url:
    /((https?:\/\/|www\.)|(linkedin|github)\.com\/)[^\s{}]+/
;

Comment:
    /\/\/.*$/
;
